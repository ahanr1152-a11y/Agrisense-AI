# Copy this file to ".env" and fill in your values. NEVER share or commit .env
BLYNK_TOKEN=YOUR_BLYNK_AUTH_TOKEN
# Change if your Blynk region differs (e.g. https://sgp1.blynk.cloud, https://blr1.blynk.cloud)
BLYNK_BASE_URL=https://blynk.cloud
# Set true to force sample data
DEMO_MODE=false
# Needed to enable pump / auto-mode controls. Leave empty = controls disabled (read-only)
CONTROL_PASSWORD=
# Long random string, e.g. run: python -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=
# Set true when deployed behind HTTPS
COOKIE_SECURE=false
